{"abstract":[{"type":"text","text":"Tile store enabled for accessing local tile packs and for loading new tile packs from server."}],"identifier":{"url":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStoreUsageMode\/readAndUpdate","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"MapboxMaps"}],"roleHeading":"Case","symbolKind":"case","navigatorTitle":[{"kind":"identifier","text":"MBMTileStoreUsageModeReadAndUpdate"}],"fragments":[{"kind":"keyword","text":"case"},{"text":" ","kind":"text"},{"kind":"identifier","text":"readAndUpdate"}],"externalID":"c:@E@MBMTileStoreUsageMode@MBMTileStoreUsageModeReadAndUpdate","title":"TileStoreUsageMode.readAndUpdate","role":"symbol"},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"readAndUpdate"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All tile requests are converted to tile pack requests, i.e."},{"text":" ","type":"text"},{"type":"text","text":"the tile pack that includes the request tile will be loaded, and the tile extracted"},{"type":"text","text":" "},{"type":"text","text":"from it. In this mode, no individual tile requests will be made."}]},{"type":"paragraph","inlineContent":[{"text":"This mode can be useful if the map trajectory is predefined and the user cannot pan","type":"text"},{"text":" ","type":"text"},{"text":"freely (e.g. navigation use cases), so that there is a good chance tile packs are already loaded","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in the vicinity of the user."}]},{"inlineContent":[{"text":"If users can pan freely, this mode is not recommended. Otherwise, panning","type":"text"},{"type":"text","text":" "},{"type":"text","text":"will download tile packs instead of using individual tiles. Note that this means that we could first"},{"type":"text","text":" "},{"type":"text","text":"download an individual tile, and then a tile pack that also includes this tile. The individual tile in"},{"text":" ","type":"text"},{"text":"the disk cache won’t be used as long as the up-to-date tile pack exists in the cache.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.mapbox.MapboxMaps\/documentation\/Overview","doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps","doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStore-APIs","doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStoreUsageMode"]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mapboxmaps\/tilestoreusagemode\/readandupdate"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/mapboxmaps\/tilestoreusagemode\/readandupdate"]}],"references":{"doc://com.mapbox.MapboxMaps/documentation/MapboxMaps/TileStore-APIs":{"identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStore-APIs","kind":"article","abstract":[],"type":"topic","title":"TileStore APIs","role":"collectionGroup","url":"\/documentation\/mapboxmaps\/tilestore-apis"},"doc://com.mapbox.MapboxMaps/documentation/MapboxMaps/TileStoreUsageMode/readAndUpdate":{"type":"topic","url":"\/documentation\/mapboxmaps\/tilestoreusagemode\/readandupdate","abstract":[{"type":"text","text":"Tile store enabled for accessing local tile packs and for loading new tile packs from server."}],"navigatorTitle":[{"text":"MBMTileStoreUsageModeReadAndUpdate","kind":"identifier"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"readAndUpdate","kind":"identifier"}],"role":"symbol","title":"TileStoreUsageMode.readAndUpdate","kind":"symbol","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStoreUsageMode\/readAn